# 這是範例。實際的 .env 請用 ./install.sh 產生（會填入隨機密碼與權杖），不要手抄這份。
POSTGRES_PASSWORD=change-me
# 儲存層：pg（預設，圓桌直接把記憶寫進 Postgres 的 rt_memories 表）或 mem0（沿用 Mem0，要 ./install.sh --with-mem0）
RT_STORE=pg
# Postgres 帳號與資料庫名。新裝是 roundtable；從 1.0.0 升上來的是 mem0（./install.sh upgrade 會自動填）。
# data/postgres 初始化之後改這兩個不會生效。要接外部的 Postgres，用 docker-compose.override.yml 覆寫 DATABASE_URL。
PG_USER=roundtable
PG_DB=roundtable
# 向量維度，跟 embedding 模型成對（Qwen3-Embedding-0.6B 是 1024）；裝好後不要改，換模型見 docs/operations.md
EMB_DIMS=1024
# 下面兩個只有 Mem0 後端（RT_STORE=mem0 或啟用 mem0 profile）才用到，./install.sh 會一併產生
MEM0_API_KEY=change-me-long-random
MEM0_JWT_SECRET=change-me-long-random
BOARD_USER=roundtable
BOARD_PASSWORD=change-me
# 每個 AI（或每台裝置）一把權杖：MCP_TOKEN_<名字>，名字大寫、連字號寫成底線（codex-laptop → MCP_TOKEN_CODEX_LAPTOP）
MCP_TOKEN_CLAUDE=change-me-long-random
MCP_TOKEN_CODEX=change-me-long-random
RT_PORT=8890
RT_BIND=0.0.0.0
RT_PUBLIC_URL=
TZ_OFFSET_HOURS=8
MCP_ALIASES=
PERSONA_NAMES=
PERSONA_WRITERS=
# MSG_ARCHIVE=0        關掉每日自動封存舊留言
# BOARD_REV_CHECK=0    關掉「舊頁面不能寫入」的檢查
# 選配服務，逗號隔開：mem0（Mem0 儲存層）、relay（轉送站）。./install.sh --with-mem0、--with-relay 會自動填。
COMPOSE_PROFILES=
# Mem0 在別台機器（不是一鍵全包的那個）才設：RT_STORE=mem0 時圓桌連這裡，./install.sh migrate 也從這裡搬
# MEM0_URL=http://別台:8000
# 轉送站（選用；./install.sh --with-relay 會自動填下面這些並把 relay 加進 COMPOSE_PROFILES，見 relay/README.md）
# RELAY_RT_TOKEN=      路由表那個身分的權杖（上面 MCP_TOKEN_<名字> 其中一把，照抄）
# RELAY_EXTRA_TOKENS=  要一起看的其他身分：codex-laptop=權杖,hermes=權杖
# RELAY_TOKEN=         收信那台電腦連轉送站要帶的權杖，自己隨機產生一串
# RELAY_BIND=127.0.0.1 收信的電腦不在同一台就改 0.0.0.0（只限內網）；埠 RELAY_PORT 預設 8891
