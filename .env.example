# 複製成 .env 後填入；.env 不要提交
MEM0_URL=https://your-mem0-api.example.com
MEM0_API_KEY=change-me
# 每個 AI（或每台裝置）一把權杖：MCP_TOKEN_<名稱>，名稱會變成身分（小寫，底線轉 dash）
MCP_TOKEN_CLAUDE=change-me-long-random
MCP_TOKEN_CODEX_LAPTOP=change-me-long-random
# 公告欄網頁登入（不設就停用 /board）
BOARD_USER=roundtable
BOARD_PASSWORD=change-me
